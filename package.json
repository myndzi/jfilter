{
    "name": "jfilter",
    "version": "2.0.0",
    "type": "module",
    "description": "Turns a splunk-like query string into a function that matches arbitrary javascript objects",
    "repository": {
        "type": "git",
        "url": "https://github.com/myndzi/jfilter.git"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "build": "rm -rf dist && tsc",
        "prepublishOnly": "npm run build && npm test"
    },
    "files": [
        "dist/*.js",
        "dist/*.d.ts",
        "!dist/*.test.js",
        "!dist/*.test.d.ts",
        "LICENSE",
        "README.md"
    ],
    "author": "Kris Reeves",
    "license": "ISC",
    "devDependencies": {
        "@types/double-ended-queue": "^2.1.7",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "prettier": "^3.10.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "chevrotain": "^13.2.0",
        "double-ended-queue": "^2.1.0-0"
    }
}
